<rdf:Description rdf:about="">
<dc:identifier></dc:identifier>
<dc:title>Assessing a computational pipeline to identify binding motifs to the &#x3b1;2&#x3b2;1 integrin</dc:title>
<prism:doi></prism:doi>
<prism:url></prism:url>
<dc:creator><rdf:Bag><rdf:li>Qianchen Liu</rdf:li>
<rdf:li>Alberto Perez</rdf:li>
</rdf:Bag></dc:creator>
<dc:description>Integrins in the cell surface interact with functional motifs found in the extracellular matrix (ECM) that queue the cell for biological actions such as migration, adhesion, or growth.</dc:description>
